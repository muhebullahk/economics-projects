{com}. ////////////////////////////////////////////////////
> * 2. CREATING IMPUTED TEST SCORE VARIABLES
. ////////////////////////////////////////////////////
> 
. 
. capture drop gk_pct_imp g1_pct_imp g2_pct_imp g3_pct_imp
{txt}
{com}. 
. gen gk_pct_imp = gk_pctscore
{txt}(5,699 missing values generated)

{com}. gen g1_pct_imp = g1_pctscore
{txt}(4,966 missing values generated)

{com}. gen g2_pct_imp = g2_pctscore
{txt}(5,241 missing values generated)

{com}. gen g3_pct_imp = g3_pctscore
{txt}(5,246 missing values generated)

{com}. 
. 
. ////////////////////////////////////////////////////
> * First grade
. ////////////////////////////////////////////////////
> 
. * If missing in grade 1 but observed in K and 2 -> average surrounding years
. replace g1_pct_imp = (gk_pctscore + g2_pctscore)/2 ///
>     if missing(g1_pct_imp) & !missing(gk_pctscore) & !missing(g2_pctscore)
{txt}(104 real changes made)

{com}. 
. * If missing in grade 1, observed in K and 3, and still missing in 2 -> average outer years
. replace g1_pct_imp = (gk_pctscore + g3_pctscore)/2 ///
>     if missing(g1_pct_imp) & !missing(gk_pctscore) & missing(g2_pctscore) & !missing(g3_pctscore)
{txt}(32 real changes made)

{com}. 
. * If student exits after K and never returns by 1 -> carry forward K score
. replace g1_pct_imp = gk_pctscore ///
>     if missing(g1_pct_imp) & !missing(gk_pctscore) & missing(g2_pctscore) & missing(g3_pctscore)
{txt}(1,562 real changes made)

{com}. 
. ////////////////////////////////////////////////////
> * Second grade
. ////////////////////////////////////////////////////
> 
. * If missing in grade 2 but observed in 1 and 3 -> average surrounding years
. replace g2_pct_imp = (g1_pctscore + g3_pctscore)/2 ///
>     if missing(g2_pct_imp) & !missing(g1_pctscore) & !missing(g3_pctscore)
{txt}(170 real changes made)

{com}. 
. * If missing in grade 2 and student exits after grade 1 -> carry forward grade 1 score
. replace g2_pct_imp = g1_pctscore ///
>     if missing(g2_pct_imp) & !missing(g1_pctscore) & missing(g3_pctscore)
{txt}(1,732 real changes made)

{com}. 
. * If grades 1 and 2 are both missing, but K and 3 are observed -> use outer-year average
. replace g2_pct_imp = (gk_pctscore + g3_pctscore)/2 ///
>     if missing(g2_pct_imp) & !missing(gk_pctscore) & missing(g1_pctscore) & !missing(g3_pctscore)
{txt}(32 real changes made)

{com}.         
. ////////////////////////////////////////////////////
> * Third grade
. ////////////////////////////////////////////////////
> 
. * If missing in grade 3, carry forward most recent observed score
. replace g3_pct_imp = g2_pctscore ///
>     if missing(g3_pct_imp) & !missing(g2_pctscore)
{txt}(1,367 real changes made)

{com}. 
. replace g3_pct_imp = g1_pctscore ///
>     if missing(g3_pct_imp) & missing(g2_pctscore) & !missing(g1_pctscore)
{txt}(1,732 real changes made)

{com}. 
. replace g3_pct_imp = gk_pctscore ///
>     if missing(g3_pct_imp) & missing(g2_pctscore) & missing(g1_pctscore) & !missing(gk_pctscore)
{txt}(1,562 real changes made)

{com}. 
. ////////////////////////////////////////////////////
