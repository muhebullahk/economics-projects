. /////////////////////////////////////////
> //// Figure I panels ////////////////////
> /////////////////////////////////////////
> 
. * A. Kindergarten entrants
. twoway ///
> (kdensity gk_pctscore if flaggk==1 & gkclasstype==1, lpattern(solid)) ///
> (kdensity gk_pctscore if flaggk==1 & gkclasstype==2, lpattern(dash)), ///
> legend(order(1 "Small" 2 "Regular")) ///
> title("A. Kindergarten") ///
> xtitle("Average SAT percentile score") ///
> ytitle("Density") ///
> name(fig1a, replace)
{res}{txt}
{com}. 
. * B. First-grade entrants
. twoway ///
> (kdensity g1_pctscore if flaggk==0 & flagg1==1 & g1classtype==1, lpattern(solid)) ///
> (kdensity g1_pctscore if flaggk==0 & flagg1==1 & g1classtype==2, lpattern(dash)), ///
> legend(order(1 "Small" 2 "Regular")) ///
> title("B. First Grade") ///
> xtitle("Average SAT percentile score") ///
> ytitle("Density") ///
> name(fig1b, replace)
{res}{txt}
{com}. 
. * C. Second-grade entrants
. twoway ///
> (kdensity g2_pctscore if flagg1==0 & flagg2==1 & g2classtype==1, lpattern(solid)) ///
> (kdensity g2_pctscore if flagg1==0 & flagg2==1 & g2classtype==2, lpattern(dash)), ///
> legend(order(1 "Small" 2 "Regular")) ///
> title("C. Second Grade") ///
> xtitle("Average SAT percentile score") ///
> ytitle("Density") ///
> name(fig1c, replace)
{res}{txt}
{com}. 
. * D. Third-grade entrants
. twoway ///
> (kdensity g3_pctscore if flagg2==0 & flagg3==1 & g3classtype==1, lpattern(solid)) ///
> (kdensity g3_pctscore if flagg2==0 & flagg3==1 & g3classtype==2, lpattern(dash)), ///
> legend(order(1 "Small" 2 "Regular")) ///
> title("D. Third Grade") ///
> xtitle("Average SAT percentile score") ///
> ytitle("Density") ///
> name(fig1d, replace)
{res}{txt}
{com}. 
. 
. *Combine all panels 
. graph combine fig1a fig1b fig1c fig1d, col(2) ///
> title("Figure I. Distribution of Average SAT Percentile Scores")
{res}{txt}
{com}. 
