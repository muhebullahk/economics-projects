. eststo clear
{txt}
{com}. generate BA=0
{txt}
{com}. replace BA=1 if educ>4
{txt}(213,646 real changes made)

{com}. generate female=0
{txt}
{com}. replace female=1 if gender==2
{txt}(283,386 real changes made)

{com}. generate ln_wage=log(hrlyearn)
{txt}
{com}. generate immigrant=0
{txt}
{com}. replace immigrant=1 if immig<3
{txt}(134,640 real changes made)

{com}. generate age1=0
{txt}
{com}. replace age1=1 if age_12==04
{txt}(78,980 real changes made)

{com}. generate age2=0
{txt}
{com}. replace age2=1 if age_12==05
{txt}(81,121 real changes made)

{com}. generate age3=0
{txt}
{com}. replace age3=1 if age_12==06
{txt}(79,141 real changes made)

{com}. generate age4=0
{txt}
{com}. replace age4=1 if age_12==07
{txt}(73,295 real changes made)

{com}. generate age5=0
{txt}
{com}. replace age5=1 if age_12==08
{txt}(68,866 real changes made)

{com}. generate age6=0
{txt}
{com}. replace age6=1 if age_12==09
{txt}(60,877 real changes made)

{com}. generate age7=0
{txt}
{com}. replace age7=1 if age_12==10
{txt}(50,713 real changes made)

{com}. gen const=1
{txt}
{com}. 
. local vars ln_wage tenure female immigrant age1 age2 age3 age4 age5 age6 age7
{txt}
{com}. 
. foreach v of local vars {c -(}
{txt}  2{com}. 
.     * Mean for BA = 0
.     quietly reg `v' const if BA==0,noconstant 
{txt}  3{com}.     eststo `v'_0, title("")
{txt}  4{com}. 
.     * Mean for BA = 1
.     quietly reg `v' const if BA==1,noconstant 
{txt}  5{com}.     eststo `v'_1, title("")
{txt}  6{com}. 
.     * Difference (regression)
.     quietly reg `v' i.BA
{txt}  7{com}.     eststo `v'_diff, title("")
{txt}  8{com}. 
. {c )-}
{txt}
{com}. 
. 
. 
. estout ln_wage_0 ln_wage_1 ln_wage_diff using "$tables\table1.tex", replace cells(mean(fmt(%9.3f)) b(star fmt(%9.3f)) se(par fmt(%9.3f))) ///
>     collabels(none)  label  rename(1.BA "const") keep(const) style(tex)   ///
